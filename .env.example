# Copy to .env and adjust as needed:  cp .env.example .env

# --- Ports (fixed) ---
# Public entry (nginx, published to the host). Cloudflare origin points here.
HOST_PORT=38378
# Internal upstreams (not published in prod; shown for reference).
WEB_PORT=38373
API_PORT=38372

# --- Next.js API base URLs ---
# Browser (client components): same-origin, relative. Resolves through whatever
# served the page (:38378 in docker, the dev server locally).
NEXT_PUBLIC_API_BASE=/api
# Server-side (server components / route handlers): direct to the backend.
# Inside the single container the backend is reachable on localhost:38372.
API_BASE_URL=http://localhost:38372/api
